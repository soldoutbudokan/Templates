# Server-only. Never prefix these names with NEXT_PUBLIC_.
# Generate a private device key with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
COUNTING_SYNC_KEY=

# Connect a persistent Upstash Redis database to this Vercel project.
# Vercel Marketplace's KV_REST_API_URL / KV_REST_API_TOKEN names also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

COUNTING_SYNC_TIME_ZONE=America/Toronto
COUNTING_SYNC_NAMESPACE=counting-trainer
